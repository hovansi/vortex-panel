# Vortex Panel. Set PUBLIC_URL=https://vortex.example.com and TRUST_PROXY=1 in /etc/bedrock-panel.env.
# TLS certificates must already exist. Replace hostname and paths below.
server {
    listen 80;
    server_name vortex.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name vortex.example.com;
    ssl_certificate /etc/letsencrypt/live/vortex.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vortex.example.com/privkey.pem;
    # Allow the 1 GiB version package plus the multipart envelope.
    client_max_body_size 1025m;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /ws {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
