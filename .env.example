# Set these through systemd EnvironmentFile or your process environment.
# Node does not implicitly load .env files.
HOST=127.0.0.1
PORT=3000
DATA_DIR=/var/lib/vortex-panel
# Required when behind HTTPS reverse proxy.
# PUBLIC_URL=https://vortex.example.com:19191
# Optional explicit game IPv4 for a main VPS behind NAT, particularly with a domain PUBLIC_URL.
# A literal public IPv4 in PUBLIC_URL is used automatically when the NIC is private.
# VORTEX_GAME_PUBLIC_IP=YOUR_PUBLIC_IPV4
TRUST_PROXY=0
ALLOW_HOST_TERMINAL=false
# Set to off to disable bounded HTTPS IP-estimated host location lookups.
VORTEX_GEOLOCATION=on
